<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nordum (nrd) — hand-authored rules for LingoTweaker.

  Nordum is a constructed pan-Scandinavian written language
  (<https://www.nordum.org>); there is no upstream LanguageTool module.
  Sources: NORDUM_LANGUAGE_SPECIFICATION.md (v0.9.1) and the owner-approved
  rule list in new-languages/nordum/proposed-rules.md.

  No tagger is available: rules must not use postag/inflected matching.
  Rule ids are stable and must never be renumbered.
-->
<rules lang="nrd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <category id="GRAMMAR" name="Grammar">
        <rule id="NDM_ATT_AA" name="att before an infinitive → å">
            <pattern>
                <marker>
                    <token>att</token>
                </marker>
                <token regexp="yes">\p{L}+(?:e|es)$</token>
            </pattern>
            <antipattern>
                <token>att</token>
                <token regexp="yes">\p{L}+(?:e|es)$</token>
                <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg|við</token>
            </antipattern>
            <message>«å» is the infinitive marker; «att» is the conjunction «that».</message>
            <suggestion>å</suggestion>
            <short>å/att</short>
            <example correction="å">Det er viktig <marker>att</marker> lære språket.</example>
            <example>Det er viktig å lære språket.</example>
            <example>Jei vet att hun arbeider.</example>
        </rule>

        <rule id="NDM_AA_ATT" name="å before a clause → att">
            <pattern>
                <token regexp="yes">vet|vite|sier|sa|tror|trodde|synes|mener|hører|ser|serr</token>
                <marker>
                    <token>å</token>
                </marker>
                <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <message>«att» is the conjunction «that»; «å» only marks an infinitive.</message>
            <suggestion>att</suggestion>
            <short>å/att</short>
            <example correction="att">Jei vet <marker>å</marker> hun arbeider.</example>
            <example>Jei vet att hun arbeider.</example>
        </rule>

        <rule id="NDM_NEG_SUB" name="ikke placement in subordinate clauses">
            <pattern>
                <token regexp="yes">att|fordi|hvis|om|når|da|mens|siden|dersom|ettersom</token>
                <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                <marker>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token>ikke</token>
                </marker>
            </pattern>
            <message>In subordinate clauses «ikke» comes before the main verb: «att hun ikke arbeider».</message>
            <suggestion>ikke <match no="3"/></suggestion>
            <short>Negation</short>
            <example correction="ikke arbeider">Jei vet att hun <marker>arbeider ikke</marker>.</example>
            <example>Jei vet att hun ikke arbeider.</example>
        </rule>

        <rule id="NDM_NEG_MAIN" name="ikke placement in main clauses">
            <pattern>
                <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                <marker>
                    <token>ikke</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får</token>
                </marker>
            </pattern>
            <antipattern>
                <token regexp="yes">att|fordi|hvis|om|når|da|mens|siden|dersom|ettersom</token>
                <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                <token>ikke</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får</token>
            </antipattern>
            <message>In main clauses «ikke» comes after the finite verb: «Jei arbeider ikke».</message>
            <suggestion><match no="3"/> ikke</suggestion>
            <short>Negation</short>
            <example correction="arbeider ikke">Jei <marker>ikke arbeider</marker>.</example>
            <example>Jei arbeider ikke.</example>
        </rule>

        <rule id="NDM_V2" name="V2 inversion after a fronted adverbial">
            <pattern>
                <token regexp="yes">Nå|Snart|Ofte|Alltid|Aldri|Kanskje|Heldigvis|Dessverre|Likevel|Derfor|Sjelden|Egentlig</token>
                <marker>
                    <token regexp="yes">jei|du|han|hun|vi|ni|de|jeg|jag|eg</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|gør</token>
                </marker>
            </pattern>
            <message>After a fronted adverbial the finite verb comes before the subject (V2).</message>
            <suggestion><match no="3"/> <match no="2"/></suggestion>
            <short>Word order</short>
            <example correction="arbeider jei">I dag <marker>jei arbeider</marker> jemme.</example>
            <example>I dag arbeider jei jemme.</example>
            <example>Nå må du gå.</example>
        </rule>

        <rule id="NDM_ADJ_NEUTER" name="neuter adjective -t">
            <pattern>
                <token regexp="yes">ett|et</token>
                <marker>
                    <token regexp="yes">[a-zæøåäö]{2,}(?&lt;!e)(?&lt;!t)</token>
                </marker>
                <token regexp="yes">hus|barn|bord|brev|språk|år|ord|land|vand|vann|øl|brød|kjøkken|bad|rom|vindu|eple|tre|dyr|fjell|hav|hjerte|hode|bilde|spørsmål|svar|problem|system|program|punkt|kapittel|dokument|prosjekt|møte|arbeid|forhold|eksempel|nummer|minutt|sekund|døgn|menneske|øye|øre|ben|hår|stykke|par|glas|glass|fat|kort|spil|spill|lag|tog|fly|skip</token>
            </pattern>
            <message>The neuter singular adjective takes «-t»: «ett stort hus».</message>
            <suggestion><match no="2" regexp_match="^(.+)$" regexp_replace="$1t"/></suggestion>
            <short>Agreement</short>
            <example correction="stort">Vi har ett <marker>stor</marker> hus.</example>
            <example correction="praktiskt">ett <marker>praktisk</marker> språk</example>
            <example>Vi har ett stort hus.</example>
        </rule>

        <rule id="NDM_ADJ_PLURAL" name="plural adjective -e">
            <pattern>
                <marker>
                    <token regexp="yes">[a-zæøåäö]{2,}(?&lt;!e)<exception>flere</exception><exception>få</exception><exception>små</exception></token>
                </marker>
                <token regexp="yes">jentar|pijar|flikkar|husar|barnar|bilar|hundar|kattar|dagar|eplar|gutar|jentarna|pijarna|flikkarna|husarna|barnarna</token>
            </pattern>
            <message>The plural adjective takes «-e»: «store bilar».</message>
            <suggestion><match no="1" regexp_match="^(.+)$" regexp_replace="$1e"/></suggestion>
            <short>Agreement</short>
            <example correction="store">Vi har <marker>stor</marker> bilar.</example>
            <example>Vi har store bilar.</example>
        </rule>

        <rule id="NDM_PRON_SUBJ_HAM" name="ham as subject → han">
            <pattern>
                <token postag="SENT_START"/>
                <marker>
                    <token>ham</token>
                </marker>
                <token regexp="yes">\p{L}{2,}r|er|har|går|kan|vil|skal|må|bør|kom|gikk|var|hadde|ble|fikk|tok|ga|sa|gør</token>
            </pattern>
            <message>As the subject the pronoun is «han», not «ham».</message>
            <suggestion>han</suggestion>
            <short>Pronoun</short>
            <example correction="han">Ham arbeider i dag.</example>
            <example>Han arbeider i dag.</example>
        </rule>

        <rule id="NDM_PRON_SUBJ_HENNE" name="henne as subject → hun">
            <pattern>
                <token postag="SENT_START"/>
                <marker>
                    <token>henne</token>
                </marker>
                <token regexp="yes">\p{L}{2,}r|er|har|går|kan|vil|skal|må|bør|kom|gikk|var|hadde|ble|fikk|tok|ga|sa|gør</token>
            </pattern>
            <message>As the subject the pronoun is «hun», not «henne».</message>
            <suggestion>hun</suggestion>
            <short>Pronoun</short>
            <example correction="hun">Henne arbeider i dag.</example>
            <example>Hun arbeider i dag.</example>
        </rule>

        <rule id="NDM_PRON_SUBJ_DEM" name="dem as subject → de">
            <pattern>
                <token postag="SENT_START"/>
                <marker>
                    <token>dem</token>
                </marker>
                <token regexp="yes">\p{L}{2,}r|er|har|går|kan|vil|skal|må|bør|kom|gikk|var|hadde|ble|fikk|tok|ga|sa|gør</token>
            </pattern>
            <message>As the subject the pronoun is «de», not «dem».</message>
            <suggestion>de</suggestion>
            <short>Pronoun</short>
            <example correction="de">Dem arbeider i dag.</example>
            <example>De arbeider i dag.</example>
        </rule>

        <rule id="NDM_PRON_SUBJ_MEI" name="mei as subject → jei">
            <pattern>
                <token postag="SENT_START"/>
                <marker>
                    <token>mei</token>
                </marker>
                <token regexp="yes">\p{L}{2,}r|er|har|går|kan|vil|skal|må|bør|kom|gikk|var|hadde|ble|fikk|tok|ga|sa|gør</token>
            </pattern>
            <message>As the subject the pronoun is «jei», not «mei».</message>
            <suggestion>jei</suggestion>
            <short>Pronoun</short>
            <example correction="jei">Mei arbeider i dag.</example>
            <example>Jei arbeider i dag.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_HENNE" name="hun after a preposition → henne">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>hun</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «henne» is used.</message>
            <suggestion>henne</suggestion>
            <short>Pronoun</short>
            <example correction="henne">Jei snakker med <marker>hun</marker>.</example>
            <example>Jei snakker med henne.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_MEI" name="jei after a preposition → mei">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>jei</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «mei» is used.</message>
            <suggestion>mei</suggestion>
            <short>Pronoun</short>
            <example correction="mei">Jei snakker med <marker>jei</marker>.</example>
            <example>Jei snakker med mei.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_DEI" name="du after a preposition → dei">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>du</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «dei» is used.</message>
            <suggestion>dei</suggestion>
            <short>Pronoun</short>
            <example correction="dei">Jei snakker med <marker>du</marker>.</example>
            <example>Jei snakker med dei.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_OSS" name="vi after a preposition → oss">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>vi</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «oss» is used.</message>
            <suggestion>oss</suggestion>
            <short>Pronoun</short>
            <example correction="oss">Jei snakker med <marker>vi</marker>.</example>
            <example>Jei snakker med oss.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_DEM" name="de after a preposition → dem">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>de</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «dem» is used.</message>
            <suggestion>dem</suggestion>
            <short>Pronoun</short>
            <example correction="dem">Jei snakker med <marker>de</marker>.</example>
            <example>Jei snakker med dem.</example>
        </rule>

        <rule id="NDM_PRON_OBJ_HAM" name="han after a preposition → ham">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellem|ved|av|fra|gennem|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>han</token>
                </marker>
            </pattern>
            <message>After a preposition the object pronoun «ham» is used.</message>
            <suggestion>ham</suggestion>
            <short>Pronoun</short>
            <example correction="ham">Jei snakker med <marker>han</marker>.</example>
            <example>Jei snakker med ham.</example>
        </rule>

        <rule id="NDM_OG_AA" name="og after a modal verb → å">
            <pattern>
                <token regexp="yes">vil|ville|skal|skulle|kan|kunne|må|måtte|bør|burde</token>
                <marker>
                    <token>og</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <message>After a modal verb the infinitive marker «å» is used, not the conjunction «og».</message>
            <suggestion>å</suggestion>
            <short>og/å</short>
            <example correction="å">Jei vil <marker>og</marker> lære nordum.</example>
            <example>Jei vil å lære nordum.</example>
        </rule>

        <rule id="NDM_YN_QUESTION" name="yes/no question inversion">
            <regexp>^(Jei|jei|Du|du|Han|han|Hun|hun|Vi|vi|Ni|ni|De|de) ([a-zæøåäö]+) (.*)\?$</regexp>
            <message>A yes/no question starts with the finite verb: «Arbeider du i dag?».</message>
            <suggestion><match no="2" case_conversion="startupper"/> <match no="1" case_conversion="alllower"/> <match no="3"/>?</suggestion>
            <short>Word order</short>
            <example correction="Arbeider du i dag?">Du arbeider i dag?</example>
            <example>Arbeider du i dag?</example>
        </rule>

        <rule id="NDM_YN_QUESTION_SHORT" name="short yes/no question inversion">
            <regexp>^(Jei|jei|Du|du|Han|han|Hun|hun|Vi|vi|Ni|ni|De|de) ([a-zæøåäö]+)\?$</regexp>
            <message>A yes/no question starts with the finite verb: «Arbeider du?».</message>
            <suggestion><match no="2" case_conversion="startupper"/> <match no="1" case_conversion="alllower"/>?</suggestion>
            <short>Word order</short>
            <example correction="Arbeider du?">Du arbeider?</example>
            <example>Arbeider du?</example>
        </rule>

        <rule id="NDM_WH_QUESTION_SHORT" name="short wh-question inversion">
            <regexp>^(Vad|vad|Var|var|Vem|vem|Vordan|vordan|Ven|ven|Vilken|vilken) (Jei|jei|Du|du|Han|han|Hun|hun|Vi|vi|Ni|ni|De|de) ([a-zæøåäö]+)\?$</regexp>
            <message>In a wh-question the finite verb comes before the subject: «Vad gør du?».</message>
            <suggestion><match no="1" case_conversion="startupper"/> <match no="3"/> <match no="2" case_conversion="alllower"/>?</suggestion>
            <short>Word order</short>
            <example correction="Vad gør du?">Vad du gør?</example>
            <example>Vad gør du?</example>
        </rule>

        <rule id="NDM_WH_QUESTION" name="wh-question inversion">
            <regexp>^(Vad|vad|Var|var|Vem|vem|Vordan|vordan|Ven|ven|Vilken|vilken) (Jei|jei|Du|du|Han|han|Hun|hun|Vi|vi|Ni|ni|De|de) ([a-zæøåäö]+) (.*)\?$</regexp>
            <message>In a wh-question the finite verb comes before the subject: «Vad gør du?».</message>
            <suggestion><match no="1" case_conversion="startupper"/> <match no="3"/> <match no="2" case_conversion="alllower"/> <match no="4"/>?</suggestion>
            <short>Word order</short>
            <example correction="Vad gør du?">Vad du gør?</example>
            <example>Vad gør du?</example>
        </rule>

        <!-- NORDUM_LANGUAGE_SPECIFICATION.md §6.1.1: «V2 with adverbial:
             Adverbial + Verb + Subject» («I dag arbeider jei jemme»).
             Retrieved 2026-09-23. -->
        <rule id="NDM_V2_DATE" name="V2 inversion after a fronted time adverbial">
            <pattern>
                <token>i</token>
                <token regexp="yes">dag|morgon|morgen|går|fjor|år|kveld|natt|helg|sommar|sommer|vinter|haust|vår</token>
                <marker>
                    <token regexp="yes">jei|du|han|hun|vi|ni|de|jeg|jag|eg</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|gør|arbeider</token>
                </marker>
            </pattern>
            <message>After a fronted time adverbial the finite verb comes before the subject (V2): «I dag arbeider jei jemme».</message>
            <suggestion><match no="4"/> <match no="3"/></suggestion>
            <short>Word order</short>
            <example correction="arbeider jei">I dag <marker>jei arbeider</marker> jemme.</example>
            <example>I dag arbeider jei jemme.</example>
            <example>I dag må du gå.</example>
        </rule>

        <!-- NORDUM_LANGUAGE_SPECIFICATION.md §6.1.2 (subordinate clause first);
             comma placement follows the Scandinavian norm (Språkrådet,
             kommaregler: «Komma etter leddsetning som står først i en
             helsetning»), mirroring data/no and data/nn:
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/kommaregler/
             Retrieved 2026-09-23. -->
        <rule id="NDM_COMMA_FRONTED_SUB" name="comma after a fronted subordinate clause">
            <pattern>
                <marker>
                    <token regexp="yes">hvis|om|når|fordi|sidan|mens|dersom|ettersom</token>
                    <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token regexp="yes">jei|du|han|hun|vi|ni|de|det|den|jeg|jag|eg</token>
                </marker>
            </pattern>
            <message>When a subordinate clause comes first, a comma is set after it: «Hvis du kommer, blir jei glad».</message>
            <suggestion><match no="1"/> <match no="2"/> <match no="3"/>, <match no="4"/> <match no="5"/></suggestion>
            <short>Comma</short>
            <example correction="Hvis du kommer, blir jei glad">Hvis du kommer blir jei glad.</example>
            <example>Hvis du kommer, blir jei glad.</example>
        </rule>

        <!-- NORDUM_LANGUAGE_SPECIFICATION.md §6.3: «den store bilen» — the
             free-standing article takes the definite adjective form on «-e»,
             mirroring data/no and data/nn. Retrieved 2026-09-23. -->
        <rule id="NDM_DEF_ADJ" name="definite adjective -e">
            <pattern>
                <token regexp="yes">den|det|de</token>
                <marker>
                    <token regexp="yes">[a-zæøåäö]{2,}(?&lt;!e)(?&lt;!t)<exception>blå</exception><exception>grå</exception><exception>rosa</exception></token>
                </marker>
                <token regexp="yes">\p{L}+(?:en|et|ene)</token>
            </pattern>
            <message>After «den/det/de» the adjective takes the definite form on «-e»: «den store bilen».</message>
            <suggestion><match no="2" regexp_match="^(.+)$" regexp_replace="$1e"/></suggestion>
            <short>Agreement</short>
            <example correction="store">Vi har den <marker>stor</marker> bilen.</example>
            <example correction="nye">Vi så det <marker>ny</marker> huset.</example>
            <example>Vi har den store bilen.</example>
            <example>den vesle bilen</example>
        </rule>

        <!-- NORDUM_LANGUAGE_SPECIFICATION.md §6.3 (article system): either
             «en bil» (indefinite) or «bilen» (definite suffix), never both.
             Retrieved 2026-09-23. Indefinite nouns that genuinely end in «-en»
             are excepted; neuter «-et» forms are not covered (past participles
             like «et ordnet» make them too ambiguous). -->
        <rule id="NDM_ART_DEF" name="indefinite article + definite form">
            <pattern>
                <token regexp="yes">en|ett</token>
                <marker>
                    <token regexp="yes">\p{L}+(?:en|arna)<exception>orden</exception><exception>våpen</exception><exception>egen</exception><exception>morgen</exception><exception>aften</exception></token>
                </marker>
            </pattern>
            <message>The noun is either indefinite or definite: «en bil» or «bilen», not both.</message>
            <suggestion><match no="2"/></suggestion>
            <short>Article</short>
            <example correction="bilen">Jei har en <marker>bilen</marker>.</example>
            <example>Jei har en bil.</example>
            <example>Jei har bilen.</example>
            <example>Det er en orden i saken.</example>
        </rule>

        <!-- Språkrådet, Bindestrek: «der førsteleddet er et siffer … skal ordet
             skrives med bindestrek» («50-årsdag»); Nordum inherits the
             Scandinavian figure-compound norm (spec §3.3.3 compounds).
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/tegn/bindestrek/
             Retrieved 2026-09-23. Mirrors NB_/NN_HYPHEN_NUMBERS_JOINED. -->
        <rule id="NDM_HYPHEN_NUMBERS_JOINED" name="figure + compound without hyphen">
            <pattern>
                <marker>
                    <token regexp="yes">\d+(?:års|dags|timers|minutters|meters|kilos|kroners|prosent|graders|siders|ukers|måneders|årig)\p{L}*</token>
                </marker>
            </pattern>
            <message>A figure and the following compound are joined with a hyphen: «50-årsdag».</message>
            <suggestion><match no="1" regexp_match="^(\d+)(.+)$" regexp_replace="$1-$2"/></suggestion>
            <short>Hyphen</short>
            <example correction="50-årsdag">Vi feirer <marker>50årsdag</marker>.</example>
            <example>Vi feirer 50-årsdag.</example>
        </rule>
    </category>

