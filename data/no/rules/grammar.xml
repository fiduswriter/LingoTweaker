<?xml version="1.0" encoding="UTF-8"?>
<!--
  Norwegian Bokmål (no) — hand-authored rules for LingoTweaker.

  There is no upstream LanguageTool Norwegian module to port (LT ships only a
  spell-check-only dynamic language), so these rules are written from the
  Språkrådet guidance (https://sprakradet.no) and the owner-approved rule list
  in new-languages/norwegian-bokmal/proposed-rules.md.

  A POS tagger is available since the Ordbøkene dictionary build (see
  data/no/words/tagset.txt): most rules below are surface rules (only the
  SENT_START built-in tag), but the agreement rules (NB_QUANT_PLU,
  NB_DISSE_PLU, NB_DEM_COMMON, NB_DEM_NEUTER) read the tagger postags and
  synthesize their suggestions with <match postag> over the derived
  no_synth.dict (plan item B2), with the disambiguation layer
  (data/no/disambiguation.xml) cleaning the readings first.
  Rule ids are stable and must never be renumbered.
-->
<rules lang="no" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <category id="GRAMMAR" name="Grammatikk">
        <rule id="NB_TIL_OG_A" name="til og + verb → til å">
            <pattern>
                <token>til</token>
                <marker>
                    <token>og</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <antipattern>
                <token>til</token>
                <token>og</token>
                <token regexp="yes">med|fra|begynne|byrje</token>
            </antipattern>
            <message>Etter «til» skal infinitivsmerket skrives «å», ikke «og».</message>
            <suggestion>å</suggestion>
            <short>og/å</short>
            <example correction="å">Pakka er klar til <marker>og</marker> hentes.</example>
            <example correction="å">Jeg har lyst til <marker>og</marker> reise.</example>
            <example>Det er en god ting til og med for barna.</example>
            <example>Både til og fra jobb.</example>
        </rule>

        <rule id="NB_UT_OG_A" name="ut/inn å + verb → og">
            <pattern>
                <token regexp="yes">ut|inn</token>
                <marker>
                    <token>å</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <message>Her er «og» bindeordet mellom to verb, ikke infinitivsmerket «å».</message>
            <suggestion>og</suggestion>
            <short>og/å</short>
            <example correction="og">Vi skal ut <marker>å</marker> spise.</example>
            <example correction="og">Han gikk inn <marker>å</marker> la seg.</example>
            <example>Vi skal ut og spise.</example>
        </rule>

        <rule id="NB_SITTE_OG_A" name="sitte/stå/ligge/gå å + verb → og">
            <pattern>
                <token regexp="yes">sitter|står|ligger|går|satt|sto|lå|gikk</token>
                <marker>
                    <token>å</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <message>Etter sitte-, stå-, ligge- og gå-verb er «og» bindeordet, ikke «å».</message>
            <suggestion>og</suggestion>
            <short>og/å</short>
            <example correction="og">Han sitter <marker>å</marker> leser.</example>
            <example correction="og">Hun står <marker>å</marker> venter.</example>
            <example>Han sitter og leser.</example>
        </rule>

        <rule id="NB_OG_A_VERB" name="kontrollverb og + infinitiv" default="off">
            <pattern>
                <token regexp="yes">lære|lærte|begynne|begynte|prøve|prøvde|pleie|pleide|bruke|brukte|slutte|sluttet|fortsette|fortsatte|rekke|rakk|orke|orket|glemme|glemte|huske|husket|ønske|ønsket|planlegge|planla|håpe|håpet|love|lovet|velge|valgte|trenge|trengte</token>
                <marker>
                    <token>og</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <message>Sannsynligvis skal infinitivsmerket «å» brukes her (fortidsprøven: «lærte å lese», ikke «lærte og leste»).</message>
            <suggestion>å</suggestion>
            <short>og/å</short>
            <example correction="å">Hun må lære <marker>og</marker> lese.</example>
            <example>Hun må lære å lese.</example>
            <example>Han liker å lære og lese.</example>
        </rule>

        <rule id="NB_LA_LOT" name="la + objekt + infinitiv → lot">
            <pattern>
                <marker>
                    <token>la</token>
                </marker>
                <token regexp="yes">meg|deg|seg|ham|henne|oss|dere|dem|den|det</token>
                <token regexp="yes">gå|se|vite|komme|ta|få|være|ha|gjøre|si|spørre|prøve|arbeide|sove|vente|begynne|slutte|leve|bli|dra|reise|snakke|fortelle|bruke|hente|kjøpe|ligge|sitte|stå|bestemme</token>
            </pattern>
            <message>«lot» er preteritum av «å la» (tillate); «la» er preteritum av «å legge».</message>
            <suggestion>lot</suggestion>
            <short>la/lot</short>
            <example correction="lot">Han <marker>la</marker> meg gå.</example>
            <example correction="lot">De <marker>la</marker> oss vite det.</example>
            <example>Han lot meg gå.</example>
            <example>Han la boka på bordet.</example>
        </rule>

        <rule id="NB_HAN_HAM" name="han som objekt → ham">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellom|ved|av|fra|gjennom|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>han</token>
                </marker>
            </pattern>
            <message>Som objekt eller etter preposisjon anbefales «ham» på bokmål.</message>
            <suggestion>ham</suggestion>
            <short>han/ham</short>
            <example correction="ham">Jeg gikk til <marker>han</marker>.</example>
            <example>Jeg gikk til ham.</example>
        </rule>

        <rule id="NB_HUN_HENNE" name="hun som objekt → henne">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellom|ved|av|fra|gjennom|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>hun</token>
                </marker>
            </pattern>
            <message>Som objekt eller etter preposisjon heter det «henne», ikke «hun».</message>
            <suggestion>henne</suggestion>
            <short>hun/henne</short>
            <example correction="henne">Jeg så <marker>hun</marker>.</example>
            <example correction="henne">Han snakket med <marker>hun</marker>.</example>
            <example>Jeg så henne.</example>
        </rule>

        <rule id="NB_NEG_SUB" name="ikke-plassering i leddsetning">
            <pattern>
                <token regexp="yes">at|fordi|hvis|om|når|da|mens|siden|dersom|ettersom</token>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <marker>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token>ikke</token>
                </marker>
            </pattern>
            <message>I leddsetninger står «ikke» før det finitte verbet: «at han ikke kommer».</message>
            <suggestion>ikke <match no="3"/></suggestion>
            <short>ikke-plassering</short>
            <example correction="ikke kommer">Jeg vet at han <marker>kommer ikke</marker>.</example>
            <example>Jeg vet at han ikke kommer.</example>
        </rule>

        <rule id="NB_NEG_MAIN" name="ikke-plassering i helsetning">
            <pattern>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <marker>
                    <token>ikke</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får</token>
                </marker>
            </pattern>
            <antipattern>
                <token regexp="yes">at|fordi|hvis|om|når|da|mens|siden|dersom|ettersom</token>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token>ikke</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får</token>
            </antipattern>
            <message>I helsetninger står «ikke» etter det finitte verbet: «jeg vet det ikke».</message>
            <suggestion><match no="3"/> ikke</suggestion>
            <short>ikke-plassering</short>
            <example correction="kan ikke">Hun <marker>ikke kan</marker> komme.</example>
            <example>Hun kan ikke komme.</example>
        </rule>

        <rule id="NB_V2" name="V2-inversjon etter foranstilt adverbial">
            <pattern>
                <token regexp="yes">Nå|Snart|Ofte|Alltid|Aldri|Kanskje|Heldigvis|Dessverre|Likevel|Derfor|Sjelden|Egentlig</token>
                <marker>
                    <token regexp="yes">jeg|du|han|hun|vi|dere|de</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                </marker>
            </pattern>
            <message>Når et adverbial står først, må det finitte verbet komme foran subjektet (V2-regelen).</message>
            <suggestion><match no="3"/> <match no="2"/></suggestion>
            <short>V2</short>
            <example correction="reiser jeg">Nå <marker>jeg reiser</marker> til Bergen.</example>
            <example>Nå reiser jeg til Bergen.</example>
            <example>Nå må du gå.</example>
        </rule>

        <rule id="NB_V2_DATE" name="V2-inversjon etter tidsuttrykk med «i»">
            <pattern>
                <token>i</token>
                <token regexp="yes">dag|går|morgen|fjor|år|kveld|natt|helgen|helga|sommer|vinter|høst|vår</token>
                <marker>
                    <token regexp="yes">jeg|du|han|hun|vi|dere|de</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                </marker>
            </pattern>
            <message>Etter et foranstilt tidsuttrykk kommer det finitte verbet foran subjektet.</message>
            <suggestion><match no="4"/> <match no="3"/></suggestion>
            <short>V2</short>
            <example correction="arbeider jeg">I dag <marker>jeg arbeider</marker> hjemme.</example>
            <example>I dag arbeider jeg hjemme.</example>
            <example>I går kom han sent.</example>
        </rule>

        <rule id="NB_POSS_DEF" name="possessiv + bestemt form">
            <pattern>
                <marker>
                    <token regexp="yes">min|mitt|mine|din|ditt|dine|sin|sitt|sine|hans|hennes|dens|dets|vår|vårt|våre|deres</token>
                    <token regexp="yes">\p{L}+(?:en|et|ene)<exception>verden</exception><exception>morgen</exception><exception>aften</exception></token>
                </marker>
            </pattern>
            <message>Possessivet kommer etter den bestemte formen: «bilen min», ikke «min bilen».</message>
            <suggestion><match no="2"/> <match no="1"/></suggestion>
            <short>eiendomsord</short>
            <example correction="bilen min">Dette er <marker>min bilen</marker>.</example>
            <example correction="huset mitt">Dette er <marker>mitt huset</marker>.</example>
            <example>Dette er bilen min.</example>
            <example>Dette er min bil.</example>
        </rule>

        <rule id="NB_DEF_ADJ" name="adjektivets bestemte form">
            <pattern>
                <token regexp="yes">den|det|de</token>
                <marker>
                    <token regexp="yes">[a-zæøå]{2,}(?&lt;!e)</token>
                </marker>
                <token regexp="yes">\p{L}+(?:en|et|ene)</token>
            </pattern>
            <message>Etter «den/det/de» står adjektivet i bestemt form på «-e»: «den store bilen».</message>
            <suggestion><match no="2" regexp_match="^(.+)$" regexp_replace="$1e"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="store">Dette er den <marker>stor</marker> bilen.</example>
            <example correction="store">Vi så det <marker>ny</marker> huset.</example>
            <example>Dette er den store bilen.</example>
            <example>den lille bilen</example>
        </rule>

        <rule id="NB_NEUTER_T" name="intetkjønn: adjektiv på -t">
            <pattern>
                <token regexp="yes">et|ett</token>
                <marker>
                    <token regexp="yes">[a-zæøå]{2,}(?&lt;!e)(?&lt;!t)<exception>liten</exception></token>
                </marker>
                <token regexp="yes">hus|barn|bord|brev|språk|år|ord|land|vann|øl|brød|kjøkken|bad|rom|vindu|eple|tre|dyr|fjell|hav|hjerte|hode|bilde|spørsmål|svar|problem|system|program|punkt|kapittel|dokument|prosjekt|møte|arbeid|forhold|eksempel|nummer|minutt|sekund|døgn|menneske|øye|øre|bein|hår|stykke|par|glass|fat|kort|spill|lag|tog|fly|skip|mot|kort|brett</token>
            </pattern>
            <message>Intetkjønnsadjektivet får «-t» i entall: «et stort hus».</message>
            <suggestion><match no="2" regexp_match="^(.+)$" regexp_replace="$1t"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="stort">Vi bor i et <marker>stor</marker> hus.</example>
            <example correction="praktiskt">et <marker>praktisk</marker> språk</example>
            <example>Vi bor i et stort hus.</example>
            <example>et lite hus</example>
        </rule>

        <rule id="NB_PLURAL_ADJ" name="adjektiv i flertall">
            <pattern>
                <marker>
                    <token regexp="yes">[a-zæøå]{2,}(?&lt;!e)<exception>få</exception><exception>små</exception><exception>grå</exception><exception>blå</exception><exception>rå</exception></token>
                </marker>
                <token regexp="yes">biler|jenter|gutter|bøker|bilder|problemer|dager|byer|veier|epler|hunder|katter|skoler|jobber|steder|møter|eksempler|muligheter|utfordringer|resultater|prosjekter|systemer|programmer|dokumenter|kapitler|punkter|planter|blomster|trær|innsjøer|elver|strender|husene|barna|bilene|jentene|guttene|ordene|bildene|problemene|dagene|møtene|mulighetene|utfordringene|resultatene</token>
            </pattern>
            <message>Adjektivet får «-e» i flertall: «store biler».</message>
            <suggestion><match no="1" regexp_match="^(.+)$" regexp_replace="$1e"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="store">Vi har <marker>stor</marker> biler.</example>
            <example>Vi har store biler.</example>
        </rule>

        <!-- POS-based rules (plan item B2): they read the Ordbøkene tagger
             readings (data/no/words/tagset.txt) and synthesize the corrected
             form with <match postag> over the derived no_synth.dict. The
             disambiguation layer (data/no/disambiguation.xml) cleans the
             readings before matching. -->
        <rule id="NB_QUANT_PLU" name="flertallsord + entallssubstantiv">
            <pattern>
                <token regexp="yes">[Mm]ange|[Ff]lere|[Bb]egge|[Ss]amtlige</token>
                <marker>
                    <token postag_regexp="yes" postag="sub:.*:sin"><exception postag_regexp="yes" postag="sub:.*:plu"/></token>
                </marker>
            </pattern>
            <message>Etter «mange/flere/begge/samtlige» står substantivet i flertall.</message>
            <suggestion><match no="2" postag="sub:ube:plu"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="biler">Han har <marker>mange bil</marker>.</example>
            <example correction="ganger">Flere <marker>gang</marker> har jeg sagt det.</example>
            <example correction="sider">Vi så begge <marker>side</marker> av saken.</example>
            <example>Han har mange biler.</example>
            <example>Flere ganger har jeg sagt det.</example>
            <example>Begge deler er bra.</example>
            <example>Samtlige deltagere møtte opp.</example>
        </rule>

        <rule id="NB_DISSE_PLU" name="disse + entallssubstantiv">
            <pattern>
                <token regexp="yes">[Dd]isse</token>
                <marker>
                    <token postag_regexp="yes" postag="sub:.*:sin"><exception postag_regexp="yes" postag="sub:.*:plu"/></token>
                </marker>
            </pattern>
            <message>Etter «disse» står substantivet i bestemt flertall: «disse bilene».</message>
            <suggestion><match no="2" postag="sub:bes:plu"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="bilene">Disse <marker>bilen</marker> er ny.</example>
            <example correction="jentene">Disse <marker>jente</marker> leser mye.</example>
            <example>Disse bilene er nye.</example>
            <example>Disse jentene leser mye.</example>
        </rule>

        <rule id="NB_DEM_COMMON" name="dette + hankjønn/hunkjønn-substantiv">
            <pattern>
                <token regexp="yes">[Dd]ette</token>
                <marker>
                    <token postag="sub:bes:sin" regexp="yes">[A-Za-zæøåÆØÅ]+(?:en|a)</token>
                </marker>
            </pattern>
            <message>Hankjønn/hunkjønn-substantiv tar «denne»: «denne bilen».</message>
            <suggestion><match no="1" regexp_match="^(.)ette$" regexp_replace="${1}enne"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="Denne">Dette <marker>bilen</marker> står der.</example>
            <example correction="Denne">Dette <marker>jenta</marker> ler.</example>
            <example>Denne bilen står der.</example>
            <example>Dette huset er gammelt.</example>
            <example>Dette er min bil.</example>
        </rule>

        <rule id="NB_DEM_NEUTER" name="denne + intetkjønn-substantiv">
            <pattern>
                <token regexp="yes">[Dd]enne</token>
                <marker>
                    <token postag="sub:bes:sin" regexp="yes">[A-Za-zæøåÆØÅ]+et</token>
                </marker>
            </pattern>
            <message>Intetkjønns-substantiv tar «dette»: «dette huset».</message>
            <suggestion><match no="1" regexp_match="^(.)enne$" regexp_replace="${1}ette"/></suggestion>
            <short>samsvarsbøyning</short>
            <example correction="Dette">Denne <marker>huset</marker> er gammelt.</example>
            <example correction="Dette">Denne <marker>barnet</marker> sover.</example>
            <example>Dette huset er gammelt.</example>
            <example>Denne boken er god.</example>
        </rule>

        <rule id="NB_VIRKE_SOM" name="virke/høres/late + som at">
            <pattern>
                <token regexp="yes">virker|virket|høres|hørtes|later|lot</token>
                <token>som</token>
                <marker>
                    <token>at</token>
                </marker>
            </pattern>
            <message>Etter «som» brukes «om» eller ingen konjunksjon: «virker som om».</message>
            <suggestion>om</suggestion>
            <short>som om</short>
            <example correction="om">Det virker som <marker>at</marker> han mener det.</example>
            <example>Det virker som om han mener det.</example>
        </rule>

        <rule id="NB_QUESTION_INVERSION" name="spørsmål med påstandsrekkefølge" default="off">
            <regexp>^(Du|du|Jeg|jeg|Han|han|Hun|hun|Vi|vi|De|de|Dere|dere) ([a-zæøå]+) (.*)\?$</regexp>
            <message>I spørsmål kommer det finitte verbet før subjektet: «Har du sett den?».</message>
            <suggestion><match no="2" case_conversion="startupper"/> <match no="1" case_conversion="alllower"/> <match no="3"/>?</suggestion>
            <short>Spørsmål</short>
            <example correction="Har du sett den?">Du har sett den?</example>
            <example>Har du sett den?</example>
        </rule>

        <rule id="NB_DA_NAR" name="da/når i fortid" default="off">
            <pattern>
                <marker>
                    <token>når</token>
                </marker>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token regexp="yes">var|hadde|kom|gikk|ble|fikk|tok|så|sa|begynte|sluttet</token>
            </pattern>
            <message>Om en enkeltstående hendelse i fortiden brukes «da», ikke «når»: «Da jeg var liten …».</message>
            <suggestion>da</suggestion>
            <short>da/når</short>
            <example correction="Da">Når jeg var liten, bodde vi i Oslo.</example>
            <example>Da jeg var liten, bodde vi i Oslo.</example>
        </rule>

        <rule id="NB_HYPHEN_NUMBERS_JOINED" name="tall + sammensatt ord uten bindestrek">
            <pattern>
                <marker>
                    <token regexp="yes">\d+(?:års|dags|timers|minutters|meters|kilos|kroners|prosent|graders|siders|ukers|måneders|årig)\p{L}*</token>
                </marker>
            </pattern>
            <message>Tall og etterfølgende sammensetning skilles med bindestrek: «50-årsdag».</message>
            <suggestion><match no="1" regexp_match="^(\d+)(.+)$" regexp_replace="$1-$2"/></suggestion>
            <short>bindestrek</short>
            <example correction="50-årsdag">Vi feirer <marker>50årsdag</marker>.</example>
            <example>Vi feirer 50-årsdag.</example>
        </rule>

        <rule id="NB_HYPHEN_NUMBERS_SPACED" name="tall + sammensetning med mellomrom">
            <pattern>
                <token regexp="yes">\d+</token>
                <marker>
                    <token regexp="yes">årsdag|årsjubileum|årsjubileet|årsgrense|årsalder|årsmøte|årsrapport|årslønn|årskurs|årskrig|årskrigen|årig|årige|dagers|timers|minutters|meters|kilos|kroners|siders|ukers|måneders</token>
                </marker>
            </pattern>
            <message>Tall og etterfølgende sammensetning skilles med bindestrek, ikke mellomrom: «18-årsgrense».</message>
            <suggestion>-<match no="2"/></suggestion>
            <short>bindestrek</short>
            <example correction="18-årsgrense">Det er en <marker>årsgrense</marker> på 18 for dette.</example>
            <example>Det er en 18-årsgrense for dette.</example>
        </rule>

        <rule id="NB_ABBREV_HYPHEN" name="forkortelse + ord med bindestrek">
            <pattern>
                <marker>
                    <token regexp="yes">NRK|TV|PC|IT|DVD|CD|USB|HTML|PDF|EU|USA|FN|SSB|NTNU|UiO|SMS|BMI|ADHD|GPS|ISO|NRK2|TV2</token>
                    <token regexp="yes">\p{L}{3,}</token>
                </marker>
            </pattern>
            <antipattern>
                <token regexp="yes">NRK|TV|PC|IT|DVD|CD|USB|HTML|PDF|EU|USA|FN|SSB|NTNU|UiO|SMS|BMI|ADHD|GPS|ISO|NRK2|TV2</token>
                <token regexp="yes">er|har|var|kan|skal|vil|må|bør|ikke|og|eller|som|at|på|i|med|for|til|av|fra|ved|over|under|mot|uten|bare|også|her|der|nå</token>
            </antipattern>
            <message>Forkortelser og påfølgende ord skilles med bindestrek: «NRK-medarbeider».</message>
            <suggestion><match no="1"/>-<match no="2"/></suggestion>
            <short>bindestrek</short>
            <example correction="NRK-medarbeider">Han er <marker>NRK medarbeider</marker>.</example>
            <example>Han er NRK-medarbeider.</example>
            <example>TV er gøy.</example>
        </rule>

        <rule id="NB_DE_DEM_SUBJ" name="dem som subjekt">
            <pattern>
                <token postag="SENT_START"/>
                <marker>
                    <token>dem</token>
                </marker>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
            </pattern>
            <message>Som subjekt skrives «de», ikke «dem».</message>
            <suggestion>de</suggestion>
            <short>de/dem</short>
            <example correction="de">Dem kommer i morgen.</example>
            <example>De kommer i morgen.</example>
        </rule>

        <rule id="NB_DE_DEM_OBJ" name="de som objekt (anbefalt dem)">
            <pattern>
                <token regexp="yes">til|med|på|hos|etter|rundt|mot|uten|mellom|ved|av|fra|gjennom|over|under|bak|foran|innom|blant</token>
                <marker>
                    <token>de</token>
                </marker>
                <token regexp="yes">som|der|her</token>
            </pattern>
            <message>Som objekt anbefales «dem» på bokmål.</message>
            <suggestion>dem</suggestion>
            <short>de/dem</short>
            <example correction="dem">Gi klærne til de som trenger dem.</example>
            <example>Gi klærne til dem som trenger dem.</example>
        </rule>

        <rule id="NB_MYE_MANGE" name="mye + flertall">
            <pattern>
                <marker>
                    <token>mye</token>
                </marker>
                <token regexp="yes">biler|jenter|gutter|bøker|bilder|problemer|dager|byer|veier|epler|hunder|katter|skoler|jobber|steder|møter|eksempler|muligheter|utfordringer|resultater|prosjekter|systemer|programmer|dokumenter|kapitler|punkter|planter|blomster|trær|innsjøer|elver|strender</token>
            </pattern>
            <message>Tellelige substantiv i flertall tar «mange», ikke «mye».</message>
            <suggestion>mange</suggestion>
            <short>mye/mange</short>
            <example correction="mange">Vi har <marker>mye</marker> biler.</example>
            <example>Vi har mange biler.</example>
        </rule>

        <rule id="NB_LITE_FA" name="lite + flertall">
            <pattern>
                <marker>
                    <token>lite</token>
                </marker>
                <token regexp="yes">biler|jenter|gutter|bøker|bilder|problemer|dager|byer|veier|epler|hunder|katter|skoler|jobber|steder|møter|eksempler|muligheter|utfordringer|resultater|prosjekter|systemer|programmer|dokumenter|kapitler|punkter|planter|blomster|trær|innsjøer|elver|strender</token>
            </pattern>
            <message>Tellelige substantiv i flertall tar «få», ikke «lite».</message>
            <suggestion>få</suggestion>
            <short>lite/få</short>
            <example correction="få">Det er <marker>lite</marker> biler i byen.</example>
            <example>Det er få biler i byen.</example>
        </rule>

        <rule id="NB_HVEM_HVILKEN" name="hvem + substantiv">
            <pattern>
                <marker>
                    <token>hvem</token>
                </marker>
                <token regexp="yes">bok|bøker|bil|biler|hus|jobb|skole|film|dag|uke|måned|time|ting|person|mann|kvinne|gutt|jente|by|gate|vei|katt|hund|stol|bord|seng|dør|vindu|klokke|telefon</token>
            </pattern>
            <message>Foran et substantiv brukes «hvilken/hvilket/hvilke», ikke «hvem».</message>
            <suggestion>hvilken</suggestion>
            <short>hvem/hvilken</short>
            <example correction="Hvilken">Hvem bok leser du?</example>
            <example>Hvilken bok leser du?</example>
        </rule>

        <rule id="NB_COMMA_FRONTED_SUB" name="komma etter foranstilt leddsetning">
            <pattern>
                <marker>
                    <token regexp="yes">hvis|da|når|fordi|siden|mens|dersom|ettersom|selv om</token>
                    <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa</token>
                    <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                </marker>
            </pattern>
            <message>Når en leddsetning står først, settes det komma etter den: «Hvis du kommer, blir jeg glad».</message>
            <suggestion><match no="1"/> <match no="2"/> <match no="3"/>, <match no="4"/> <match no="5"/></suggestion>
            <short>komma</short>
            <example correction="Hvis du kommer, blir jeg glad">Hvis du kommer blir jeg glad.</example>
            <example>Hvis du kommer, blir jeg glad.</example>
        </rule>

        <!-- Språkrådet, Hermeteikn: «Komma skal setjast utanfor» hermeteikna
             (regelen blei endra i 2004; før det stod komma inne).
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/tegn/hermeteikn/
             Retrieved 2026-09-23. -->
        <rule id="NB_COMMA_QUOTES" name="komma inne i hermeteikn">
            <pattern>
                <token regexp="yes">\p{L}+</token>
                <marker>
                    <token>,</token>
                    <token>»</token>
                </marker>
            </pattern>
            <message>Komma skal stå utenfor hermeteikna: «Jeg kommer i morgen», sa han.</message>
            <suggestion>»,</suggestion>
            <short>hermeteikn</short>
            <example correction="»,">Han sa «Ja,» til meg.</example>
            <example>«Jeg kommer i morgen», sa han.</example>
            <example>Han sa «nei» til forslaget.</example>
        </rule>

        <!-- Språkrådet, kommaregler: «Det skal stå komma mellom sidestilte
             helsetninger som er bundet sammen med og, eller, for».
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/kommaregler/
             Retrieved 2026-09-23. Risky with surface patterns (subordinate
             clauses joined by og without repeated conjunction must NOT get a
             comma), so the rule is off by default. -->
        <rule id="NB_COMMA_SIDEORDNING" name="komma mellom sidestilte helsetninger" default="off">
            <pattern>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|er|har</token>
                <marker>
                    <token regexp="yes">og|eller|for</token>
                </marker>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|er|har</token>
            </pattern>
            <antipattern>
                <token regexp="yes">at|fordi|hvis|om|når|da|mens|siden|dersom|ettersom</token>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|er|har</token>
                <token regexp="yes">og|eller|for</token>
            </antipattern>
            <message>Komma mellom sidestilte helsetninger: «Vi kan gå tur, eller vi kan sitte inne og drikke kakao».</message>
            <suggestion>, <match no="3"/></suggestion>
            <short>komma</short>
            <example correction=", eller">Han dro eller han ble hjemme.</example>
            <example correction=", for">Jeg blir hjemme for det er sent.</example>
            <example>Han dro, eller han ble hjemme.</example>
            <example>Jeg blir hjemme, for det er sent.</example>
            <example>Jeg vet at han kommer og jeg blir glad.</example>
        </rule>

        <!-- Språkrådet, kommaregler (oppramsing): «det skal ikke stå komma
             foran og eller eller» i oppramsing.
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/kommaregler/
             Retrieved 2026-09-23. Flertallsformer på -r kan likne finite verb,
             så regelen er slått av som standard. -->
        <rule id="NB_COMMA_OPPRAMSING" name="komma foran og/eller i oppramsing" default="off">
            <pattern>
                <token regexp="yes">\p{L}+</token>
                <marker>
                    <token>,</token>
                    <token regexp="yes">og|eller</token>
                </marker>
                <token regexp="yes">\p{L}+</token>
            </pattern>
            <antipattern>
                <token regexp="yes">og|eller</token>
                <token regexp="yes">jeg|du|han|hun|vi|dere|de|det</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|er|har</token>
            </antipattern>
            <antipattern>
                <token regexp="yes">og|eller</token>
                <token regexp="yes">hvis|om|når|mens|da|fordi|siden|dersom|som|at|men</token>
            </antipattern>
            <antipattern>
                <token regexp="yes">og|eller</token>
                <token regexp="yes">\p{L}+</token>
                <token regexp="yes">\p{L}{2,}r|ville|kunne|skulle|måtte|burde|kan|vil|skal|må|bør|får|kom|gikk|så|satt|lå|sto|var|hadde|ble|fikk|tok|ga|sa|er|har</token>
            </antipattern>
            <message>I oppramsing skal det ikke stå komma foran «og»/«eller»: «brød, kaker og boller».</message>
            <suggestion> <match no="3"/></suggestion>
            <short>komma</short>
            <example correction=" og">Vi kjøpte brød, kaker, og boller.</example>
            <example>Vi kjøpte brød, kaker og boller.</example>
            <example>Alle eksamenskandidatene må møte kl. 9, og ingen hjelpemidler er tillatt.</example>
        </rule>

        <!-- Språkrådet, Tankestrek: streken angir tallområder og svarer til
             «fra … til» («kapitlene 2–10»); bindestrek og tankestrek må ikke
             blandes sammen.
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/tegn/tankestrek/
             Retrieved 2026-09-23. Ryddes bare der bindestreken står mellom to
             siffer og ikke er en del av en lengre tallrekke, så regelen er av
             som standard. -->
        <rule id="NB_DASH_RANGE" name="bindestrek i tallområde → tankestrek" default="off">
            <pattern>
                <marker>
                    <token regexp="yes">^\d+-\d+$</token>
                </marker>
            </pattern>
            <antipattern>
                <token regexp="yes">\d+</token>
                <token>-</token>
                <token regexp="yes">\d+</token>
                <token>-</token>
            </antipattern>
            <message>Tallområder skrives med tankestrek uten å blande med bindestrek: «kapitlene 2–10».</message>
            <suggestion><match no="1" regexp_match="^(\d+)-(\d+)$" regexp_replace="$1–$2"/></suggestion>
            <short>bindestrek/tankestrek</short>
            <example correction="–">Kapitlene 2-10 er korte.</example>
            <example>Kapitlene 2–10 er korte.</example>
            <example>Les kapitlene 2-10 og 14-15.</example>
        </rule>

        <!-- Språkrådet, Hermeteikn: «Vinkelspissane skal vende utover i norsk»,
             og doble vinkelhermeteikn (« … ») er standard i bøker og aviser.
             https://sprakradet.no/godt-og-korrekt-sprak/rettskriving-og-grammatikk/tegn/hermeteikn/
             Retrieved 2026-09-23. Konvertering av rette anførselstegn kan støye
             i programkode o.l., så regelen er av som standard. -->
        <rule id="NB_STRAIGHT_QUOTES" name="rette anførselstegn → «»" default="off">
            <regexp>"([^"]+)"</regexp>
            <message>Standard norske hermeteikn er «…», og vinkelspissene skal vende utover.</message>
            <suggestion>«<match no="1"/>»</suggestion>
            <short>hermeteikn</short>
            <example correction="«nei»">Han sa "nei" til forslaget.</example>
            <example>Han sa «nei» til forslaget.</example>
        </rule>
    </category>

    <category id="TYPOS" name="Mulig skrivefeil"/>
